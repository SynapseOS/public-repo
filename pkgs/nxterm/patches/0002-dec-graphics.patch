+/* Render DEC box characters as cell geometry, independent of font encoding. */
+static int draw_acs(char c) {
+	unsigned edges = 0; /* left, right, up, down */
+	switch (c) {
+		case 'q':
+			edges = 3;
+			break;
+		case 'x':
+			edges = 12;
+			break;
+		case 'l':
+			edges = 10;
+			break;
+		case 'k':
+			edges = 9;
+			break;
+		case 'm':
+			edges = 6;
+			break;
+		case 'j':
+			edges = 5;
+			break;
+		case 't':
+			edges = 14;
+			break;
+		case 'u':
+			edges = 13;
+			break;
+		case 'w':
+			edges = 11;
+			break;
+		case 'v':
+			edges = 7;
+			break;
+		case 'n':
+			edges = 15;
+			break;
+		default:
+			return 0;
+	}
+
+	sflush( );
+	GR_GC_INFO info;
+	GrGetGCInfo(gc1, &info);
+	int x = curx * fonw, y = cury * fonh, cx = x + fonw / 2, cy = y + fonh / 2;
+	GrSetGCForeground(gc1, info.background);
+	GrFillRect(w1, gc1, x, y, fonw, fonh);
+	GrSetGCForeground(gc1, info.foreground);
+
+	if (edges & 1)
+		GrLine(w1, gc1, x, cy, cx, cy);
+
+	if (edges & 2)
+		GrLine(w1, gc1, cx, cy, x + fonw - 1, cy);
+
+	if (edges & 4)
+		GrLine(w1, gc1, cx, y, cx, cy);
+
+	if (edges & 8)
+		GrLine(w1, gc1, cx, cy, cx, y + fonh - 1);
+	return 1;
+}
