+dev_t
+get_process_ttyname(char *name, size_t namelen)
+{
+    struct stat sb;
+    int fd = sudo_open_session_tty(O_RDONLY, false);
+    if (fd == -1) {
+        errno = ENOENT;
+        return NODEV;
+    }
+    if (fstat(fd, &sb) == -1) {
+        close(fd);
+        return NODEV;
+    }
+    if (namelen != 0 && ttyname_r(fd, name, namelen) != 0)
+        *name = '\0';
+    close(fd);
+    return sb.st_rdev;
+}
