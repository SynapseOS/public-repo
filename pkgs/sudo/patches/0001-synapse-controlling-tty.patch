+#ifdef __synapse__
+#include <sys/vfs.h>
+#include <termios.h>
+#include <sudo_synapse_tty.h>
+
+static bool
+session_terminal(int fd, pid_t sid, pid_t pgid, bool foreground)
+{
+    return tcgetsid(fd) == sid && (!foreground || tcgetpgrp(fd) == pgid);
+}
+
+/*
+ * /dev/tty on SynapseOS is the serial device.  Resolve a verified inherited
+ * descriptor through procfs to get an independent open file description.
+ * PTY forwarding changes O_NONBLOCK and must not change the shell's flags.
+ */
+int
+sudo_open_session_tty(int flags, bool foreground)
+{
+    struct statfs fs;
+    struct stat src, dst;
+    pid_t sid = getsid(0), pgid = getpgrp();
+    int dir, fd = -1;
+
+    if (sid <= 0 || pgid <= 0)
+        goto absent;
+    dir = open("/proc/self/fd", O_RDONLY | O_CLOEXEC | O_DIRECTORY);
+    if (dir == -1)
+        goto absent;
+    if (fstatfs(dir, &fs) == 0 && fs.f_type == 0x9fa0) {
+        for (int i = 0; i <= STDERR_FILENO; i++) {
+            const char name[] = {(char)('0' + i), '\0'};
+            if (fstat(i, &src) == -1 || !S_ISCHR(src.st_mode) ||
+                !session_terminal(i, sid, pgid, foreground))
+                continue;
+            fd = openat(dir, name, flags | O_CLOEXEC | O_NOCTTY | O_NONBLOCK);
+            if (fd == -1)
+                continue;
+            if (fstat(fd, &dst) == 0 && S_ISCHR(dst.st_mode) &&
+                src.st_dev == dst.st_dev && src.st_ino == dst.st_ino &&
+                src.st_rdev == dst.st_rdev && session_terminal(fd, sid, pgid, foreground)) {
+                int mode = fcntl(fd, F_GETFL);
+                if (mode != -1 && fcntl(fd, F_SETFL, mode & ~O_NONBLOCK) == 0)
+                    break;
+            }
+            close(fd);
+            fd = -1;
+        }
+    }
+    close(dir);
+    if (fd != -1)
+        return fd;
+absent:
+    errno = ENXIO;
+    return -1;
+}
+
+FILE *
+sudo_session_tty_stream(void)
+{
+    int fd = sudo_open_session_tty(O_WRONLY, false);
+    if (fd == -1)
+        return NULL;
+    FILE *fp = fdopen(fd, "w");
+    if (fp == NULL)
+        close(fd);
+    return fp;
+}
