--- a/auto/feature
+++ b/auto/feature
@@ -13,6 +13,26 @@
 END
 
 ngx_found=no
+
+# Runtime feature tests cannot execute the target CRT on the build host.
+case "$NGX_PLATFORM:$ngx_feature_run" in
+    SynapseOS:*:yes) ngx_feature_run=no ;;
+esac
+
+# Host probes must not enable Linux facilities absent from SynapseOS.
+case "$NGX_PLATFORM:$ngx_feature_name" in
+    SynapseOS:*:NGX_HAVE_FIONREAD | \
+    SynapseOS:*:NGX_HAVE_ACCEPT4 | SynapseOS:*:NGX_HAVE_INET6 | \
+    SynapseOS:*:NGX_HAVE_REUSEPORT | SynapseOS:*:NGX_HAVE_DEFERRED_ACCEPT | \
+    SynapseOS:*:NGX_HAVE_SYSVSHM | SynapseOS:*:NGX_HAVE_POSIX_SEM | \
+    SynapseOS:*:NGX_HAVE_SCHED_SETAFFINITY | SynapseOS:*:NGX_HAVE_FILE_AIO | \
+    SynapseOS:*:NGX_HAVE_PWRITEV | SynapseOS:*:NGX_HAVE_O_DIRECT | \
+    SynapseOS:*:NGX_HAVE_TRANSPARENT_PROXY | SynapseOS:*:NGX_HAVE_DLOPEN | \
+    SynapseOS:*:NGX_HAVE_TCP_FASTOPEN | SynapseOS:*:NGX_HAVE_IP_BIND_ADDRESS_NO_PORT)
+        echo " disabled for SynapseOS"
+        return
+    ;;
+esac
 
 if test -n "$ngx_feature_name"; then
     ngx_have_feature=`echo $ngx_feature_name \
