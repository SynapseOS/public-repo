+// Обновить название окна на панели только при его изменении
+static void
+shell_surface_publish_task(struct shell_surface *shsurf)
+{
+	const char *title;
+	char *copy;
+
+	if (!shsurf->shell->child.desktop_shell || !shsurf->desktop_surface) {
+		return;
+	}
+
+	title = weston_desktop_surface_get_title(shsurf->desktop_surface);
+	if (!title || !title[0]) {
+		title = "Window";
+	}
+
+	if (shsurf->task_title && strcmp(shsurf->task_title, title) == 0) {
+		return;
+	}
+
+	copy = strdup(title);
+	if (!copy) {
+		return;
+	}
+
+	free(shsurf->task_title);
+	shsurf->task_title = copy;
+	weston_desktop_shell_send_minimized(shsurf->shell->child.desktop_shell,
+					   shsurf->task_id, title);
+}
