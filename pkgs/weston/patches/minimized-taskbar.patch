+// Передать панели текущий список свёрнутых окон
+static void
+desktop_shell_list_minimized(struct wl_client *client,
+			     struct wl_resource *resource)
+{
+	struct desktop_shell *shell = wl_resource_get_user_data(resource);
+	struct shell_surface *shsurf;
+
+	wl_list_for_each(shsurf, &shell->shsurf_list, link) {
+		if (shsurf->minimized && shsurf->desktop_surface) {
+			const char *title = weston_desktop_surface_get_title(shsurf->desktop_surface);
+			weston_desktop_shell_send_minimized(resource, shsurf->task_id,
+						   title ? title : "Window");
+		}
+	}
+}
+
+// Вернуть выбранное окно на рабочий стол
+static void
+desktop_shell_restore_minimized(struct wl_client *client,
+				struct wl_resource *resource, uint32_t id)
+{
+	struct desktop_shell *shell = wl_resource_get_user_data(resource);
+	struct shell_surface *shsurf;
+	struct weston_seat *seat;
+	struct workspace *ws;
+
+	if (wl_list_empty(&shell->compositor->seat_list)) {
+		return;
+	}
+
+	wl_list_for_each(shsurf, &shell->shsurf_list, link) {
+		if (shsurf->task_id != id || !shsurf->minimized) {
+			continue;
+		}
+
+		ws = get_current_workspace(shell);
+		weston_view_move_to_layer(shsurf->view, &ws->layer.view_list);
+		seat = wl_container_of(shell->compositor->seat_list.next, seat, link);
+		activate(shell, shsurf->view, seat, WESTON_ACTIVATE_FLAG_CONFIGURE);
+		return;
+	}
+}
