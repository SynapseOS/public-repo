+// Перерисовать панели после изменения списка окон
+static void
+desktop_redraw_panels(struct desktop *desktop)
+{
+	struct output *output;
+
+	wl_list_for_each(output, &desktop->outputs, link) {
+		if (output->panel) {
+			widget_schedule_redraw(output->panel->widget);
+		}
+	}
+}
+
+// Добавить свёрнутое окно на панели
+static void
+desktop_shell_minimized(void *data, struct weston_desktop_shell *shell,
+			uint32_t id, const char *title)
+{
+	struct desktop *desktop = data;
+	struct desktop_task *task;
+
+	wl_list_for_each(task, &desktop->minimized_tasks, link) {
+		if (task->id == id) {
+			free(task->title);
+			task->title = xstrdup(title);
+			desktop_redraw_panels(desktop);
+			return;
+		}
+	}
+
+	task = xzalloc(sizeof *task);
+	task->id = id;
+	task->title = xstrdup(title);
+	wl_list_insert(desktop->minimized_tasks.prev, &task->link);
+	desktop_redraw_panels(desktop);
+}
+
+// Убрать восстановленное или закрытое окно с панели
+static void
+desktop_shell_unminimized(void *data, struct weston_desktop_shell *shell,
+			  uint32_t id)
+{
+	struct desktop *desktop = data;
+	struct desktop_task *task;
+	struct desktop_task *next;
+
+	wl_list_for_each_safe(task, next, &desktop->minimized_tasks, link) {
+		if (task->id == id) {
+			wl_list_remove(&task->link);
+			free(task->title);
+			free(task);
+			break;
+		}
+	}
+	desktop_redraw_panels(desktop);
+}
