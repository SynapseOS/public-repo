+// Восстановить окно при нажатии на его название на панели
+static void
+panel_button_handler(struct widget *widget, struct input *input,
+		     uint32_t time, uint32_t button,
+		     enum wl_pointer_button_state state, void *data)
+{
+	struct panel *panel = data;
+	struct desktop_task *task;
+	struct rectangle allocation;
+	int32_t x;
+	int32_t y;
+	int position;
+
+	if (state != WL_POINTER_BUTTON_STATE_RELEASED || button != BTN_LEFT) {
+		return;
+	}
+
+	input_get_position(input, &x, &y);
+	widget_get_allocation(widget, &allocation);
+	if (x < panel->task_start || x >= allocation.width - (panel->clock ? 150 : 0)) {
+		return;
+	}
+
+	position = panel->task_start;
+	wl_list_for_each(task, &panel->desktop->minimized_tasks, link) {
+		if (x >= position && x < position + 110) {
+			weston_desktop_shell_restore_minimized(panel->desktop->shell, task->id);
+			return;
+		}
+		position += 110;
+	}
+}
