# terminal-server-decorations.patch: Рамки композитора и цвета сайта для терминала
# Автор: Елчинян Арен Артурович, 2026, архитектура x86_64, ABI Wayland
# Подсистема: графическая оболочка
# Первое изменение: 29.10.2026, последнее изменение: 24.11.2026
# Статус доступа: общедоступный
--- a/clients/terminal.c
+++ b/clients/terminal.c
@@ -902,7 +902,7 @@ terminal_resize(struct terminal *terminal, int columns, int rows)
 	width = columns * terminal->average_width + m;
 	height = rows * terminal->extents.height + m;
 
-	window_frame_set_child_size(terminal->widget, width, height);
+	window_schedule_resize(terminal->window, width, height);
 }
 
 struct color_scheme DEFAULT_COLORS = {
@@ -911,16 +911,16 @@ struct color_scheme DEFAULT_COLORS = {
-		{0,    0,    0,    1}, /* black */
-		{0.66, 0,    0,    1}, /* red */
-		{0  ,  0.66, 0,    1}, /* green */
-		{0.66, 0.33, 0,    1}, /* orange (nicer than muddy yellow) */
-		{0  ,  0  ,  0.66, 1}, /* blue */
-		{0.66, 0  ,  0.66, 1}, /* magenta */
-		{0,    0.66, 0.66, 1}, /* cyan */
-		{0.66, 0.66, 0.66, 1}, /* light grey */
-		{0.22, 0.33, 0.33, 1}, /* dark grey */
-		{1,    0.33, 0.33, 1}, /* high red */
-		{0.33, 1,    0.33, 1}, /* high green */
-		{1,    1,    0.33, 1}, /* high yellow */
-		{0.33, 0.33, 1,    1}, /* high blue */
-		{1,    0.33, 1,    1}, /* high magenta */
-		{0.33, 1,    1,    1}, /* high cyan */
-		{1,    1,    1,    1}  /* white */
+		{0.188, 0.212, 0.227, 1},
+		{0.588, 0.212, 0.118, 1},
+		{0.129, 0.392, 0.267, 1},
+		{0.467, 0.349, 0.039, 1},
+		{0.000, 0.400, 0.600, 1},
+		{0.420, 0.310, 0.557, 1},
+		{0.122, 0.478, 0.549, 1},
+		{0.541, 0.584, 0.612, 1},
+		{0.992, 0.992, 0.973, 1},
+		{0.753, 0.286, 0.180, 1},
+		{0.173, 0.490, 0.322, 1},
+		{0.627, 0.478, 0.047, 1},
+		{0.118, 0.525, 0.722, 1},
+		{0.541, 0.420, 0.690, 1},
+		{0.165, 0.596, 0.678, 1},
+		{0.188, 0.212, 0.227, 1}
@@ -928,2 +928,2 @@ struct color_scheme DEFAULT_COLORS = {
-	0,                             /* black border */
-	{7, 0, 0, }                    /* bg:black (0), fg:light gray (7)  */
+	8,
+	{15, 8, 0, }
@@ -2955,7 +2955,7 @@ terminal_create(struct display *display)
 	terminal->margin_top = 0;
 	terminal->margin_bottom = -1;
 	terminal->window = window_create(display);
-	terminal->widget = window_frame_create(terminal->window, terminal);
+	terminal->widget = window_add_widget(terminal->window, terminal);
 	terminal->title = xstrdup("Wayland Terminal");
 	window_set_title(terminal->window, terminal->title);
 	window_set_appid(terminal->window,
