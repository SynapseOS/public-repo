 static void
+report_left_press(struct terminal *terminal, int x, int y)
+{
+	struct rectangle area;
+	int cw = terminal->average_width, ch = terminal->extents.height;
+	if (cw <= 0 || ch <= 0)
+		return;
+	widget_get_allocation(terminal->widget, &area);
+	x -= area.x + (area.width - terminal->width * cw) / 2;
+	y -= area.y + (area.height - terminal->height * ch) / 2;
+	if (x < 0 || y < 0 || x / cw >= terminal->width || y / ch >= terminal->height ||
+	    x / cw >= 223 || y / ch >= 223)
+		return;
+	char report[] = {27, '[', 'M', 32, (char)(33 + x / cw), (char)(33 + y / ch)};
+	terminal_write(terminal, report, sizeof report);
+}
