{
  "name": "openssl",
  "version": "3.5.9-r2",
  "description": "OpenSSL LTS static TLS libraries and CLI; single-thread build",
  "source": "https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz",
  "sha256": "603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a",
  "source_directory": "openssl-3.5.9",
  "configure": [
    "./Configure",
    "linux-x86_64",
    "--prefix=/usr",
    "--openssldir=/etc/ssl",
    "no-shared",
    "no-threads",
    "no-async",
    "no-asm",
    "no-dso",
    "no-engine",
    "no-tests",
    "no-module",
    "no-secure-memory",
    "-D__synapse__",
    "-isystem",
    "{gcc_headers}"
  ],
  "make_targets": [
    "build_sw"
  ],
  "files": {
    "bin/openssl": "apps/openssl",
    "usr/lib/libssl.a": "libssl.a",
    "usr/lib/libcrypto.a": "libcrypto.a",
    "usr/include/openssl": "include/openssl",
    "usr/share/licenses/openssl/LICENSE.txt": "LICENSE.txt"
  },
  "patches": []
}
