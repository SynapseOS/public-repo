<openbox_menu>
    <menu id="root-menu" label="SynapseOS">
        <item label="Все программы">
            <action name="Execute" command="synapse-desktop" />
        </item>
        <menu id="quick-menu" label="Быстрый доступ">
            <item label="Файлы">
                <action name="Execute" command="synapse-files" />
            </item>
            <item label="Терминал">
                <action name="Execute" command="weston-terminal" />
            </item>
            <item label="Запись экрана">
                <action name="Execute" command="recorder-desktop" />
            </item>
            <item label="Монитор системы">
                <action name="Execute" command="synapse-desktop --monitor" />
            </item>
        </menu>
        <item label="Настройки">
            <action name="Execute" command="synapse-desktop --settings" />
        </item>
        <separator />
        <item label="Выход">
            <action name="Exit" />
        </item>
    </menu>
    <menu id="client-menu">
        <item label="Свернуть">
            <action name="Iconify" />
        </item>
        <item label="Развернуть">
            <action name="ToggleMaximize" />
        </item>
        <item label="Закрыть">
            <action name="Close" />
        </item>
    </menu>
</openbox_menu>
