+// Открыть главное меню рядом с кнопкой на панели
+static int
+handle_sigusr2(int signal, void *data)
+{
+	(void)signal;
+	struct server *server = data;
+	if (server->seat.cursor == NULL) {
+		return 0;
+	}
+
+	struct menu *menu = menu_get_by_id(server, "root-menu");
+	if (menu != NULL) {
+		menu_open_root(menu, (int)server->seat.cursor->x,
+			(int)server->seat.cursor->y);
+	}
+
 	return 0;
 }
 
