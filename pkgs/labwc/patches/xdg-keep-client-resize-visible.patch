+static void
+set_usable_client_bounds(struct view *view)
+{
+	if (output_is_usable(view->output)) {
+		struct border frame = ssd_thickness(view);
+		struct wlr_box area = view->output->usable_area;
+		wlr_xdg_toplevel_set_bounds(xdg_toplevel_from_view(view),
+			MAX(1, area.width - frame.left - frame.right),
+			MAX(1, area.height - frame.top - frame.bottom));
+	}
+}
+
+/* An oversized frame can cover the entire axis even when it cannot fit. */
+static bool
+axis_fully_visible(int pos, int extent, int start, int length)
+{
+	int64_t end = (int64_t)pos + extent;
+	int64_t bound = (int64_t)start + length;
+	return extent > length ? pos <= start && end >= bound
+		: pos >= start && end <= bound;
+}
+
+static int
+offset_into_axis(int pos, int extent, int start, int length)
+{
+	if (extent > length) {
+		return 0;
+	}
+	int64_t high = (int64_t)start + length - extent;
+	return MAX((int64_t)start, MIN((int64_t)pos, high)) - pos;
+}
+
+/* Retain a visible frame after a spontaneous resize on its current output. */
+static void
+keep_client_resize_visible(struct view *view, const struct wlr_box *before)
+{
+	struct wlr_box area = output_usable_area_in_layout_coords(view->output);
+	if (wlr_box_empty(&area)
+			|| !axis_fully_visible(before->x, before->width, area.x, area.width)
+			|| !axis_fully_visible(before->y, before->height, area.y, area.height)) {
+		return;
+	}
+	struct wlr_box frame = ssd_max_extents(view);
+	view->current.x += offset_into_axis(frame.x, frame.width, area.x, area.width);
+	view->current.y += offset_into_axis(frame.y, frame.height, area.y, area.height);
+}
