--- /dev/null
+++ b/include/wlr/backend/libinput.h
@@ -0,0 +1,32 @@
+// libinput.h: Совместимость Labwc с wlroots без libinput backend
+// Автор: Елчинян Арен Артурович, 2026
+// Архитектура: x86_64, ABI: synapse-x86_64-v1
+// Описание: Заглушки для вложенного Wayland backend
+// Подсистема: графическая оболочка
+// Первое изменение: 28.10.2026
+// Последнее изменение: 28.10.2026
+// Доступ: общедоступный
+
+#ifndef SYNAPSE_WLR_LIBINPUT_STUB_H
+#define SYNAPSE_WLR_LIBINPUT_STUB_H
+
+#include <stdbool.h>
+#include <libinput.h>
+
+struct wlr_input_device;
+
+// Указать, что вложенный backend не создает устройства libinput
+static inline bool wlr_input_device_is_libinput(struct wlr_input_device *device) {
+    (void)device;
+
+    return false;
+}
+
+// Вернуть отсутствие дескриптора libinput у вложенного устройства
+static inline struct libinput_device *wlr_libinput_get_device_handle(struct wlr_input_device *device) {
+    (void)device;
+
+    return 0;
+}
+
+#endif
