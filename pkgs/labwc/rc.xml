<!--
    rc.xml: Клавиши и оформление окон Labwc
    Автор: Елчинян Арен Артурович, 2026
    Архитектура: x86_64, ABI: Wayland
    Описание: Единые кнопки окон и доступ к меню SynapseOS
    Подсистема: графическая оболочка
    Первое изменение: 28.10.2026
    Последнее изменение: 23.11.2026
    Доступ: общедоступный
-->
<labwc_config>
    <core>
        <decoration>server</decoration>
    </core>
    <placement>
        <policy>center</policy>
    </placement>
    <theme>
        <name>synapse-classic</name>
        <titlebar>
            <layout>menu:iconify,max,close</layout>
            <showTitle>yes</showTitle>
        </titlebar>
        <cornerRadius>0</cornerRadius>
        <keepBorder>yes</keepBorder>
        <dropShadows>no</dropShadows>
        <font place="ActiveWindow">
            <name>sans</name>
            <size>10</size>
            <weight>bold</weight>
        </font>
        <font place="InactiveWindow">
            <name>sans</name>
            <size>10</size>
        </font>
    </theme>
    <focus>
        <followMouse>no</followMouse>
        <raiseOnFocus>yes</raiseOnFocus>
    </focus>
    <snapping>
        <range inner="10" outer="10" />
        <overlay enabled="yes">
            <delay inner="400" outer="400" />
        </overlay>
        <topMaximize>yes</topMaximize>
    </snapping>
    <keyboard>
        <default />
        <keybind key="Super_L" onRelease="yes">
            <action name="Execute" command="synapse-menuctl" />
        </keybind>
        <keybind key="W-space">
            <action name="Execute" command="synapse-menuctl" />
        </keybind>
        <keybind key="W-Return">
            <action name="Execute" command="weston-terminal" />
        </keybind>
        <keybind key="W-e">
            <action name="Execute" command="synapse-files" />
        </keybind>
        <keybind key="W-s">
            <action name="Execute" command="synapse-desktop --settings" />
        </keybind>
        <keybind key="W-F9">
            <action name="Execute" command="recorder pause" />
        </keybind>
        <keybind key="W-F10">
            <action name="Execute" command="recorder snapshot" />
        </keybind>
        <keybind key="W-F11">
            <action name="Execute" command="recorder stop" />
        </keybind>
    </keyboard>
    <mouse>
        <default />
    </mouse>
    <windowRules>
        <windowRule identifier="org.freedesktop.weston.wayland-terminal" serverDecoration="yes" />
        <windowRule title="Synapse Recorder HUD">
            <skipTaskbar>yes</skipTaskbar>
            <action name="MoveTo" x="20" y="20" />
            <action name="ToggleAlwaysOnTop" />
        </windowRule>
        <windowRule title="Synapse Notification">
            <skipTaskbar>yes</skipTaskbar>
            <action name="MoveTo" x="860" y="20" />
            <action name="ToggleAlwaysOnTop" />
        </windowRule>
    </windowRules>
</labwc_config>
