#!/bin/sh
# autostart: Запустить панель, рабочий стол и меню SynapseOS
# Автор: Елчинян Арен Артурович, 2026
# Архитектура: x86_64, ABI: musl и Wayland
# Описание: Подготовить рабочее пространство после запуска композитора
# Подсистема: графическая оболочка
# Первое изменение: 28.10.2026
# Последнее изменение: 22.11.2026
# Доступ: общедоступный

export DBUS_SESSION_BUS_ADDRESS="unix:path=${XDG_RUNTIME_DIR}/bus"
dbus-daemon --session --fork --address="$DBUS_SESSION_BUS_ADDRESS"
/usr/libexec/labwc/synapse-panel &
synapse-desktop --menu-service &
