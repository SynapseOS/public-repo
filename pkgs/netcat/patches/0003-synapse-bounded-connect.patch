 #include <fcntl.h>		/* O_WRONLY et al */
+
+#ifdef __synapse__
+/* Bound connect with select: this kernel's legacy alarm ABI is a stub. */
+static int synapse_connect(int fd, const struct sockaddr *address, socklen_t length, int seconds) {
+	int flags, result, saved, error;
+	socklen_t size;
+	fd_set writefds;
+	struct timeval timeout;
+
+	if (!seconds)
+		return connect(fd, address, length);
+	flags = fcntl(fd, F_GETFL);
+
+	if (flags < 0 || fcntl(fd, F_SETFL, flags | O_NONBLOCK) < 0)
+		return -1;
+	result = connect(fd, address, length);
+
+	if (result < 0 && errno == EINPROGRESS) {
+		FD_ZERO(&writefds);
+		FD_SET(fd, &writefds);
+		timeout.tv_sec = seconds;
+		timeout.tv_usec = 0;
+		result = select(fd + 1, NULL, &writefds, NULL, &timeout);
+
+		if (!result) {
+			errno = ETIMEDOUT;
+			result = -1;
+		} else if (result > 0) {
+			error = 0;
+			size = sizeof(error);
+			result = getsockopt(fd, SOL_SOCKET, SO_ERROR, &error, &size);
+
+			if (!result && error) {
+				errno = error;
+				result = -1;
+			}
+		}
+	}
+
+	saved = errno;
+
+	if (fcntl(fd, F_SETFL, flags) < 0 && !result)
+		return -1;
+	errno = saved;
+	return result;
+}
+#endif
 
