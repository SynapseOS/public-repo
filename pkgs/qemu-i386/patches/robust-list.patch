+#ifdef TARGET_NR_set_robust_list
+// Mark a mutex owned by an exiting guest thread and wake its waiters
+static void target_robust_mark_dead(CPUState *cpu, TaskState *ts,
+                                    abi_ulong entry, int32_t offset)
+{
+    abi_ulong addr = entry + offset;
+    uint32_t old_value;
+    uint32_t new_value;
+    uint32_t *host_addr;
+
+    if ((addr & 3) != 0 || !access_ok(cpu, VERIFY_WRITE, addr, sizeof(uint32_t))) {
+        return;
+    }
+
+    host_addr = g2h(cpu, addr);
+    for (;;) {
+        old_value = qatomic_read(host_addr);
+        if ((tswap32(old_value) & FUTEX_TID_MASK) != ts->ts_tid) {
+            return;
+        }
+
+        new_value = tswap32((tswap32(old_value) & FUTEX_WAITERS) | FUTEX_OWNER_DIED);
+        if (qatomic_cmpxchg(host_addr, old_value, new_value) == old_value) {
+            break;
+        }
+    }
+
+    if (tswap32(old_value) & FUTEX_WAITERS) {
+        do_sys_futex((int *)host_addr, FUTEX_WAKE, 1, NULL, NULL, 0);
+    }
+}
+
+// Walk the guest robust list before the emulated thread exits
+static void target_robust_exit(CPUState *cpu, TaskState *ts)
+{
+    abi_ulong head = ts->robust_list_head;
+    abi_ulong entry;
+    abi_ulong next;
+    abi_ulong pending;
+    int32_t offset;
+    unsigned int count;
+
+    if (head == 0 || get_user_ual(entry, head) ||
+        get_user_s32(offset, head + sizeof(abi_ulong)) ||
+        get_user_ual(pending, head + 2 * sizeof(abi_ulong))) {
+        return;
+    }
+
+    for (count = 0; entry != head && count < 2048; count++) {
+        if (get_user_ual(next, entry)) {
+            break;
+        }
+
+        if (entry != pending) {
+            target_robust_mark_dead(cpu, ts, entry, offset);
+        }
+
+        entry = next;
+    }
+
+    if (pending != 0) {
+        target_robust_mark_dead(cpu, ts, pending, offset);
+    }
+
+    ts->robust_list_head = 0;
+}
