--- a/src/gallium/drivers/llvmpipe/lp_rast.c
+++ b/src/gallium/drivers/llvmpipe/lp_rast.c
@@ -26,6 +26,11 @@
  **************************************************************************/
 
 #include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <time.h>
+#include <unistd.h>
+#include <sys/syscall.h>
 #include "util/u_memory.h"
 #include "util/u_math.h"
 #include "util/u_rect.h"
@@ -1156,12 +1161,34 @@
  *   2. do work
  *   3. signal that we're done
  */
+/* SynapseOS optional worker diagnostics. Author: Елчинян Арен Артурович,
+ * 2026, x86_64 musl ABI. First/last change: 14.10.2026.
+ * Subsystem: Mesa llvmpipe test metrics. Access: общедоступный.
+ * Thread CPU includes rasterization and synchronization; wall time includes
+ * scheduler preemption. Disabled unless SYNAPSE_LLVMPIPE_METRICS is set.
+ */
+static uint64_t
+synapse_worker_clock(clockid_t clock)
+{
+   struct timespec now;
+   if (clock_gettime(clock, &now) != 0) {
+      return 0;
+   }
+   return (uint64_t)now.tv_sec * 1000000000ULL + now.tv_nsec;
+}
+
 static int
 thread_function(void *init_data)
 {
    struct lp_rasterizer_task *task = (struct lp_rasterizer_task *) init_data;
    struct lp_rasterizer *rast = task->rast;
    bool debug = false;
+   bool synapse_metrics = getenv("SYNAPSE_LLVMPIPE_METRICS") != NULL;
+   uint64_t metric_start = synapse_metrics ? synapse_worker_clock(CLOCK_MONOTONIC) : 0;
+   uint64_t metric_cpu = synapse_metrics ? synapse_worker_clock(CLOCK_THREAD_CPUTIME_ID) : 0;
+   uint64_t raster_wall = 0;
+   unsigned metric_scenes = 0;
+   long metric_tid = synapse_metrics ? syscall(SYS_gettid) : 0;
    char thread_name[16];
 
    snprintf(thread_name, sizeof thread_name, "llvmpipe-%u", task->thread_index);
@@ -1199,7 +1226,12 @@
       if (debug)
          debug_printf("thread %d doing work\n", task->thread_index);
 
+      uint64_t raster_start = synapse_metrics ? synapse_worker_clock(CLOCK_MONOTONIC) : 0;
       rasterize_scene(task, rast->curr_scene);
+      if (synapse_metrics) {
+         raster_wall += synapse_worker_clock(CLOCK_MONOTONIC) - raster_start;
+         metric_scenes++;
+      }
 
       /* wait for all threads to finish with this scene */
       util_barrier_wait(&rast->barrier);
@@ -1214,6 +1246,19 @@
       if (debug)
          debug_printf("thread %d done working\n", task->thread_index);
 
+      if (synapse_metrics) {
+         uint64_t end = synapse_worker_clock(CLOCK_MONOTONIC);
+         if (end - metric_start >= 1000000000ULL) {
+            uint64_t cpu = synapse_worker_clock(CLOCK_THREAD_CPUTIME_ID);
+            fprintf(stderr, "SYNAPSE_LLVMPIPE_WORKER tid=%ld worker=%u elapsed_ms=%.3f cpu_ms=%.3f raster_wall_ms=%.3f scenes=%u\n",
+                    metric_tid, task->thread_index, (end - metric_start) / 1e6,
+                    (cpu - metric_cpu) / 1e6, raster_wall / 1e6, metric_scenes);
+            metric_start = end;
+            metric_cpu = cpu;
+            raster_wall = 0;
+            metric_scenes = 0;
+         }
+      }
       util_semaphore_signal(&task->work_done);
    }
 
