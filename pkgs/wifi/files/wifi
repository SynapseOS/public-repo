#!/bin/sh
# wifi: повторное подключение по закрытому профилю
# Автор: Елчинян Арен Артурович, 2026
# Архитектура: x86_64, ABI: служба SynapseOS
# Описание: Проверка связи и повторное подключение
# Подсистема: беспроводная сеть
# Первое изменение: 16.11.2026, последнее изменение: 16.11.2026
# Доступ: общедоступный

while :; do
    if [ -e /dev/wifi ] && [ -f /etc/network/wifi.conf ] &&
       /bin/wifi status | grep -q 'Connection: disconnected'; then
        /bin/wifi auto >/dev/null 2>&1
    fi

    sleep 5
done
