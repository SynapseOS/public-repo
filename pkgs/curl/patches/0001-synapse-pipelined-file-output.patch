 #include "tool_msgs.h"
 #include "tool_cb_wrt.h"
 #include "tool_operate.h"
+
+#ifdef __synapse__
+#include <pthread.h>
+
+#define SYN_WRITE_CHUNK (1024U * 1024U)
+#define SYN_WRITE_SLOTS 4U
+
+struct syn_async_writer {
+  pthread_t thread;
+  pthread_mutex_t mutex;
+  pthread_cond_t changed;
+  FILE *stream;
+  unsigned char data[SYN_WRITE_SLOTS][SYN_WRITE_CHUNK];
+  size_t length[SYN_WRITE_SLOTS];
+  unsigned int head;
+  unsigned int tail;
+  unsigned int queued;
+  bool closing;
+  bool failed;
+};
+
+// Записывать заполненные блоки, пока основной поток принимает данные
+static void *syn_async_run(void *arg)
+{
+  struct syn_async_writer *writer = arg;
+
+  pthread_mutex_lock(&writer->mutex);
+  for(;;) {
+    unsigned int index;
+    size_t length;
+    size_t written;
+
+    while(!writer->queued && !writer->closing)
+      pthread_cond_wait(&writer->changed, &writer->mutex);
+
+    if(!writer->queued)
+      break;
+
+    index = writer->head;
+    length = writer->length[index];
+    pthread_mutex_unlock(&writer->mutex);
+
+    written = fwrite(writer->data[index], 1, length, writer->stream);
+
+    pthread_mutex_lock(&writer->mutex);
+    if(written != length) {
+      writer->failed = TRUE;
+      pthread_cond_broadcast(&writer->changed);
+      break;
+    }
+
+    writer->length[index] = 0;
+    writer->head = (index + 1U) % SYN_WRITE_SLOTS;
+    writer->queued--;
+    pthread_cond_broadcast(&writer->changed);
+  }
+
+  pthread_mutex_unlock(&writer->mutex);
+  return NULL;
+}
+
+// Создать ограниченную очередь записи для обычного файла
+static bool syn_async_start(struct OutStruct *outs)
+{
+  struct syn_async_writer *writer = malloc(sizeof(*writer));
+  curlx_struct_stat fileinfo;
+
+  if(!writer)
+    return FALSE;
+
+  memset(writer, 0, sizeof(*writer));
+  writer->stream = outs->stream;
+
+  if(curlx_fstat(fileno(outs->stream), &fileinfo) ||
+     !S_ISREG(fileinfo.st_mode) ||
+     pthread_mutex_init(&writer->mutex, NULL)) {
+    free(writer);
+    return FALSE;
+  }
+
+  if(pthread_cond_init(&writer->changed, NULL)) {
+    pthread_mutex_destroy(&writer->mutex);
+    free(writer);
+    return FALSE;
+  }
+
+  if(pthread_create(&writer->thread, NULL, syn_async_run, writer)) {
+    pthread_cond_destroy(&writer->changed);
+    pthread_mutex_destroy(&writer->mutex);
+    free(writer);
+    return FALSE;
+  }
+
+  outs->async = writer;
+  return TRUE;
+}
+
+// Добавить сетевой блок в очередь без неограниченного роста памяти
+static bool syn_async_append(struct OutStruct *outs,
+                             const char *buffer, size_t bytes)
+{
+  struct syn_async_writer *writer = outs->async;
+  size_t offset = 0;
+
+  pthread_mutex_lock(&writer->mutex);
+  while(offset < bytes && !writer->failed) {
+    size_t room;
+    size_t amount;
+
+    while(writer->queued == SYN_WRITE_SLOTS && !writer->failed)
+      pthread_cond_wait(&writer->changed, &writer->mutex);
+
+    if(writer->failed)
+      break;
+
+    room = SYN_WRITE_CHUNK - writer->length[writer->tail];
+    amount = bytes - offset;
+    if(amount > room)
+      amount = room;
+
+    memcpy(writer->data[writer->tail] + writer->length[writer->tail],
+           buffer + offset, amount);
+    writer->length[writer->tail] += amount;
+    offset += amount;
+
+    if(writer->length[writer->tail] == SYN_WRITE_CHUNK) {
+      writer->queued++;
+      writer->tail = (writer->tail + 1U) % SYN_WRITE_SLOTS;
+      pthread_cond_signal(&writer->changed);
+    }
+  }
+
+  pthread_mutex_unlock(&writer->mutex);
+  return offset == bytes;
+}
+
+// Дождаться записи хвоста и освободить очередь перед работой с файлом
+bool tool_async_finish(struct OutStruct *outs)
+{
+  struct syn_async_writer *writer = outs->async;
+  bool success;
+
+  if(!writer)
+    return TRUE;
+
+  pthread_mutex_lock(&writer->mutex);
+  if(!writer->failed && writer->length[writer->tail]) {
+    writer->queued++;
+    writer->tail = (writer->tail + 1U) % SYN_WRITE_SLOTS;
+  }
+  writer->closing = TRUE;
+  pthread_cond_signal(&writer->changed);
+  pthread_mutex_unlock(&writer->mutex);
+
+  pthread_join(writer->thread, NULL);
+  success = !writer->failed;
+
+  pthread_cond_destroy(&writer->changed);
+  pthread_mutex_destroy(&writer->mutex);
+  free(writer);
+  outs->async = NULL;
+  return success;
+}
+#endif
 
